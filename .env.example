# Discord bot token (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Discord application (client) ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=

# Optional: Guild ID for fast, per-guild command deployment during development.
# Leave empty to deploy commands globally (can take up to 1 hour to propagate).
DEV_GUILD_ID=

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/application-bot

# Comma-separated Discord role IDs that are treated as "staff" by default.
# (Per-guild staff roles are also configurable at runtime via /settings staff,
# these are the developer-level fallback/bootstrap roles.)
STAFF_ROLE_IDS=

# Comma-separated Discord user IDs that get developer-only command access
# (/bot-config, /database, /reload) regardless of guild roles.
DEVELOPER_USER_IDS=

# Port for the built-in health-check HTTP server (src/keepAlive.ts).
# Render sets this automatically — you normally don't need to set it
# yourself in production. Defaults to 3000 if unset.
PORT=3000
